@'
# Python cache files
__pycache__/
*.py[cod]

# Virtual environment
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db

# Local SQLite runtime databases
agents/conversation_state.sqlite3
agents/rfp_research/rfp_opportunities.sqlite3

# Runtime data: admin-approved web research exported for indexing, and
# learner details saved with consent
knowledge_base/approved_research/
knowledge_base/metadata/approved_research_*.json
agents/rex_assistant/leads.jsonl

# The academy's uploaded application documents (real company papers)
agents/rfp_research/application_documents/

# Local REX runtime metadata and vector database
knowledge_base/metadata/
knowledge_base/vector_db/

# Agent 3: stored curricula (drafts, versions, review history) and their PDFs
agents/curriculum_research/curricula.sqlite3
agents/curriculum_research/documents/

# Agent 4: generated documents (drafts, versions, review history) and their PDFs
agents/document_generation/documents.sqlite3
agents/document_generation/documents/

# Agent 5: marketing campaigns (drafts, versions, review history)
agents/marketing/marketing.sqlite3

# SQLite runtime companions of any database (write-ahead log, shared memory, rollback journal)
*.sqlite3-*

# ChromaDB index of the course catalogue: runtime state, rebuilt by `python -m knowledge_base.pipeline`.
# (A copy was committed once and is still tracked: ignore rules do not untrack. See README "Git and runtime files".)
knowledge_base/vector_db/

PROJECT_HANDOVER.md
'@ | Set-Content -Encoding utf8 .gitignore