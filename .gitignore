# Generated knowledge base: the ChromaDB index of the academy documents and the
# ingestion's chunk metadata and manifest. Never committed -- every clone builds
# its own from knowledge_base/documents/ with `python -m knowledge_base.pipeline`
# (a committed copy came back on every branch switch and served an obsolete catalogue).
knowledge_base/vector_db/
knowledge_base/metadata/chunk_metadata.json
knowledge_base/metadata/ingestion_manifest.json
