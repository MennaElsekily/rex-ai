# REX AI configuration template.
# Copy this file to .env and fill in the values you need. Never commit .env.
# Every variable below is read by the code; empty means "not set".

# --- Secrets -------------------------------------------------------------
# Admin dashboard passcode. Empty disables admin access.
REX_ADMIN_PASSCODE=
# Tavily web search (RFP web research; Curriculum Agent research once
# approved domains are set). Empty: web research reports awaiting_credentials.
TAVILY_API_KEY=
# Read by the Etimad stub only; Etimad has no usable public API today.
ETIMAD_API_KEY=

# --- Optional settings (leave empty for the defaults) ---------------------
# Ollama model for REX Assistant (default qwen2.5:3b).
REX_LLM_MODEL=
# The knowledge base of this deployment (its authoritative catalogue):
# the ChromaDB index folder REX's RAG MCP server searches (default
# knowledge_base/vector_db), and the academy documents folder that
# `python -m knowledge_base.pipeline` ingests (default knowledge_base/documents).
REX_VECTOR_DB_DIR=
REX_DOCUMENTS_DIR=
# Ollama model for the Curriculum Agent (default: REX's model).
CURRICULUM_LLM_MODEL=
# Tender database path (default agents/rfp_research/rfp_opportunities.sqlite3).
REX_TENDER_DB_PATH=
# Application submission mode. Only "dry_run" exists; anything else is
# still treated as a dry run (nothing is ever sent).
REX_SUBMISSION_MODE=
# Approved research domains for the Curriculum Agent, comma-separated.
# Empty keeps external research OFF (see docs/CURRICULUM_AGENT_ARCHITECTURE.md §16).
CURRICULUM_RESEARCH_DOMAINS=
# Curriculum store, PDF folder, approved framework files and index
# (defaults under agents/curriculum_research/ and knowledge_base/vector_db/).
CURRICULUM_DB_PATH=
CURRICULUM_DOCUMENTS_DIR=
CURRICULUM_FRAMEWORKS_DIR=
CURRICULUM_INDEX_DIR=

# Agent 4 (Document Generation): model (default: the Curriculum Agent's model),
# document database and PDF folder (defaults under agents/document_generation/).
DOCUMENT_LLM_MODEL=
DOCUMENT_DB_PATH=
DOCUMENT_OUTPUT_DIR=

# Agent 5 (Marketing): optional model and database location (defaults: the Curriculum Agent's model; agents/marketing/marketing.sqlite3)
MARKETING_LLM_MODEL=
MARKETING_DB_PATH=

# --- Real email sending (agents/rfp_research/email_sending.py) -----------
# A dry-run expression-of-interest draft (applications.py) is never sent by
# itself. Sending it for real is a separate, explicit admin action, and
# needs all of the following:
# Resend API key. Empty: sending is refused with a clear error.
RESEND_API_KEY=
# "test" (default) or "production". Anything other than exactly
# "production" is still test mode (same convention as REX_SUBMISSION_MODE).
# Production mode changes no recipient; it also refuses drafts written
# from demonstration profile data (an example.com contact email).
REX_EMAIL_MODE=
# The ONLY address any application email is sent to, in test AND
# production mode. The tender's own contact is never used and never a
# fallback. Required (and must be a valid email address) to send at all;
# there is no built-in default.
REX_EMAIL_TEST_RECIPIENT=
# Optional: Resend only sends from a domain verified in that Resend
# account, which the academy's own contact address usually is not. When
# set, mail is sent from this address instead, with the academy's own
# address set as Reply-To.
RESEND_FROM_EMAIL=
