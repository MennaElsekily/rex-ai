# REX AI configuration template.
# Copy this file to .env and fill in the values you need. Never commit .env.
# Every variable below is read by the code; empty means "not set".

# --- Secrets -------------------------------------------------------------
# Admin dashboard passcode. Empty disables admin access.
REX_ADMIN_PASSCODE=
# Tavily web search (RFP web research; Curriculum Agent research once
# approved domains are set). Empty: web research reports awaiting_credentials.
TAVILY_API_KEY=
# Read by the Etimad stub only; Etimad has no usable public API today.
ETIMAD_API_KEY=

# --- Optional settings (leave empty for the defaults) ---------------------
# Ollama model for REX Assistant (default qwen2.5:3b).
REX_LLM_MODEL=
# Ollama model for the Curriculum Agent (default: REX's model).
CURRICULUM_LLM_MODEL=
# Tender database path (default agents/rfp_research/rfp_opportunities.sqlite3).
REX_TENDER_DB_PATH=
# Application submission mode. Only "dry_run" exists; anything else is
# still treated as a dry run (nothing is ever sent).
REX_SUBMISSION_MODE=
# Approved research domains for the Curriculum Agent, comma-separated.
# Empty keeps external research OFF (see docs/CURRICULUM_AGENT_ARCHITECTURE.md §16).
CURRICULUM_RESEARCH_DOMAINS=
# Curriculum store, PDF folder, approved framework files and index
# (defaults under agents/curriculum_research/ and knowledge_base/vector_db/).
CURRICULUM_DB_PATH=
CURRICULUM_DOCUMENTS_DIR=
CURRICULUM_FRAMEWORKS_DIR=
CURRICULUM_INDEX_DIR=
